{
  "name": "aftergrowth-protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc && cp -R public world lineage dist/",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "policy": "tsx scripts/policy.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run policy && npm run build",
    "format:check": "prettier --check src scripts tests public *.ts *.js .gitlab-ci.yml .gitlab/duo infra world lineage"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
